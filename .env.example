# ─────────────────────────────────────────────────────────────
# NEXORA ACADEMY — environment variables
# Copy to .env.local. NEXT_PUBLIC_* values are exposed to the browser:
# NEVER put secrets / private keys in them.
# ─────────────────────────────────────────────────────────────

# Demo mode (default): data from data/demo + local Route Handlers under /api.
# Set to "false" to use the real backend (requires NEXT_PUBLIC_API_BASE_URL).
NEXT_PUBLIC_USE_DEMO_API=true

# Backend mode only. Public base URL of the real API (no trailing slash).
# If missing/invalid while demo mode is off, the app falls back to demo mode.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Public origin of this site (sitemap, robots, canonical/hreflang URLs, Open Graph, JSON-LD). No trailing slash.
# Optional: if unset, Vercel's production domain is used, then https://courses-n.vercel.app (never localhost).
NEXT_PUBLIC_SITE_URL=https://courses-n.vercel.app

# Server-only, optional. "true" lets a production build fall back to demo data when the backend is unreachable.
# API_FALLBACK_TO_DEMO=false
